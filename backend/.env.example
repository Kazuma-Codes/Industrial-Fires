# Database connection (Neon Postgres with PostGIS or local Postgres)
# Example Neon: postgresql://user:password@ep-xyz.ap-south-1.aws.neon.tech/neondb?sslmode=require
# Example Local: postgresql://postgres:postgres@localhost:5432/thermal_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thermal_db

# NASA FIRMS API MAP_KEY (Register free at https://firms.modaps.eosdis.nasa.gov/api/area/)
# Leave blank or mock if using bundled local CSV fallback
FIRMS_MAP_KEY=

# Secret token to authorize admin pipeline and seeding endpoints
ADMIN_API_TOKEN=sih_ntro_thermal_secret_2026

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default Bounding Box: Jamnagar refinery corridor [W, S, E, N]
DEMO_BBOX=69.5,22.0,70.8,23.0
